# =====================================================================
# 1. ПОЛЬЗОВАТЕЛЬСКИЕ ПУТИ (PATH)
# =====================================================================
export CARGO_HOME="$HOME/.local/share/cargo"
export RUSTUP_HOME="$HOME/.local/share/rustup"
export SDKMAN_DIR="$HOME/.sdkman"

# Объединяем добавление путей в одну аккуратную строку (так быстрее для Bash)
export PATH="/home/nick/.lmstudio/bin:/home/nick/.local/bin:$CARGO_HOME/bin:$PATH"

# =====================================================================
# 2. ИНИЦИАЛИЗАЦИЯ ИНТЕРФЕЙСА (Starship и Zoxide)
# =====================================================================
unifetch
eval "$(starship init bash)"
# Убираем дубликат zoxide, так как он уже инициализируется в /etc/bash.bashrc с флагом --cmd cd
# Если убрать его из /etc, то оставьте строку ниже:
# eval "$(zoxide init bash)"

# =====================================================================
# 3. ЛИЧНЫЕ АЛИАСЫ И ПЕРЕОПРЕДЕЛЕНИЯ КОМАНД
# =====================================================================
alias foldersync='/opt/foldersync/bin/foldersync-desktop'
alias yay="paru"

# =====================================================================
# 5. СИСТЕМНЫЕ СКРИПТЫ В САМОМ КОНЦЕ ФАЙЛА
# =====================================================================
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
