-- Исправленный жест (параметры перенесены внутрь hl.gesture)
hl.gesture({
    fingers                 = 3,
    direction               = "horizontal",
    action                  = "workspace",
    workspace_swipe         = true,
    workspace_swipe_fingers = 3
})

