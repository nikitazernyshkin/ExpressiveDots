hl.bind("ALT + TAB", function()
    hl.plugin.scrolloverview.overview("toggle all")
end)

-- Переключатель лэйаутов (scrolling <-> dwindle)
local function toggle_layout()
    -- Получаем текущие настройки генеральной секции
    local current_layout = hl.get_config("general.layout")
    
    if current_layout == "scrolling" then
        -- Если сейчас scrolling, включаем dwindle (или master)
        hl.config({ general = { layout = "dwindle" } })
        hl.exec_cmd("notify-send 'Hyprland' 'Лэйаут изменен на Dwindle' -i input-window")
    else
        -- Возвращаем обратно твой scrolling
        hl.config({ general = { layout = "scrolling" } })
        hl.exec_cmd("notify-send 'Hyprland' 'Лэйаут изменен на Scrolling' -i input-window")
    end
end

-- Привязываем функцию к комбинации SUPER + SHIFT + L
hl.bind(mainMod .. "+SHIFT+L", toggle_layout, { description = "Переключить лэйаут окон" })
